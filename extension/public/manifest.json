{
  "manifest_version": 3,
  "name": "Culverin",
  "version": "0.0.1",
  "description": "Count lines of code in public GitHub repositories locally in your browser, with no servers or tracking.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://codeload.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Culverin",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.github.com https://codeload.github.com https://github.com"
  }
}
